# FinGrow Environment Variables
# Application Environment
NODE_ENV=development
PORT=3000

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication Session Secret (Generate with: openssl rand -base64 32)
SESSION_SECRET=fingrow_dev_super_secret_session_key_replace_in_production_32chars!

# Persistence
DATABASE_FILE=./data/fingrow.json

# Rate Limiting (Requests per minute)
RATE_LIMIT_AUTH=15
RATE_LIMIT_API=120

# Feature Flags
NEXT_PUBLIC_ENABLE_COMMUNITY=true
NEXT_PUBLIC_ENABLE_SIMULATIONS=true
NEXT_PUBLIC_ENABLE_GAMES=true
NEXT_PUBLIC_ENABLE_EDUCATOR=true

